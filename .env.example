# ---------- Backend (Express) ----------
PORT=5000
MONGODB_URI=mongodb://localhost:27017/eldercare
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
DEFAULT_TIMEZONE=Asia/Kolkata

# Backend -> AI service (internal). Both services must share the same key.
AI_SERVICE_URL=http://localhost:8000
AI_INTERNAL_KEY=dev-internal-key-change-me

# ---------- AI service (FastAPI) ----------
# mock = works offline with canned demo answers (no key needed)
# anthropic = real Claude (get a key at https://console.anthropic.com)
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=claude-sonnet-5-5
